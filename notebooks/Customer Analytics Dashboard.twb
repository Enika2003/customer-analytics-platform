          </named-connection>
        </named-connections>
        <relation connection='postgres.1b7r9qt0vfs42t173ahvf1n8zl9b' name='Custom SQL Query' type='text'>SELECT
    f.invoice_id,
    f.date_id,
    f.revenue,
    f.unit_price,
    f.quantity,
    f.country,
    f.customer_id,
    f.stockcode,
    cs.segment,
    ch.churn_risk,
    ch.churn_probability,
    cl.clv_segment,
    cl.predicted_clv,
    dd.year,
    dd.month,
    dd.month_name,
    dd.quarter
FROM fact_sales f
LEFT JOIN customer_segments cs ON f.customer_id = cs.customer_id
LEFT JOIN churn_scores      ch ON f.customer_id = ch.customer_id
LEFT JOIN clv_scores        cl ON f.customer_id = cl.customer_id
LEFT JOIN dim_date          dd ON f.date_id     = dd.date_id</relation>
